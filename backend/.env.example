# Completar según el entorno. No incluir credenciales reales en este archivo.

DATABASE_URL=
JWT_SECRET_KEY=

EMAIL_FROM_ADDRESS=

PAGO_API_BASE_URL=http://mock_pago_api:9000

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# Google Identity Services
# Este valor NO es un secreto.
# Corresponde al OAuth 2.0 Client ID de tipo Web.
GOOGLE_CLIENT_ID=

# Jina AI - Embeddings del RAG
JINA_API_KEY=
JINA_API_BASE_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_EMBEDDING_DIMENSION=512
JINA_TIMEOUT_SECONDS=30
JINA_MAX_RETRIES=2